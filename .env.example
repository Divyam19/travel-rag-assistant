# Copy to .env and fill in the REQUIRED values. .env is gitignored; never commit it.

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=


# Supabase Postgres connection string, used for migrations and pgvector queries.
# Project Settings -> Database -> Connection string. The "Session pooler" (port 5432) is preferred;
# the "Transaction pooler" (port 6543) also works, since the code pins its own search_path.
# Replace [YOUR-PASSWORD] with your database password.
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres

# Tavily: https://app.tavily.com  (API key, starts with "tvly-")
# Used ONLY for the web-search fallback, never for scraping.
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# MODELS (defaults are the cheap dev setup; change model names here only)
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# Routing, clarification, confidence, Tier 2 judge
SMALL_MODEL=gpt-4.1-mini
# Final answer generation. Keep equal to SMALL_MODEL while developing to save cost.
LARGE_MODEL=gpt-5.4-mini
# gpt-5* models only: minimal|low|medium|high. Higher = slower.
LARGE_MODEL_REASONING_EFFORT=low

# ---------------------------------------------------------------------------
# TAVILY CREDIT GUARDS
# ---------------------------------------------------------------------------
# Hard daily cap on Tavily calls; fallback degrades to index-only once reached.
TAVILY_DAILY_CALL_CAP=20
TAVILY_MAX_RESULTS=4
TAVILY_SEARCH_DEPTH=basic
# true = use recorded fixtures instead of live calls (0 credits)
TAVILY_USE_FIXTURES=false
WEB_RESULT_CACHE_HOURS=12
# Result pages fetched with our own scraper (free); the rest use Tavily's snippet. 0 = snippets only.
WEB_FETCH_TOP_N=4
# Interactive page fetch (and robots.txt) timeout; the bulk ingester uses SCRAPER_TIMEOUT_SECONDS.
WEB_FETCH_TIMEOUT_SECONDS=7
# Web answers get a large context; index answers stay tight.
WEB_CONTEXT_TOKENS=12000
WEB_PAGE_MAX_TOKENS=3500
WEB_MAX_PAGES=6
# Web-fallback pages are written into the corpus and expire after this many days.
WEB_ARTICLE_TTL_DAYS=14

# ---------------------------------------------------------------------------
# SCRAPER / INGESTION
# ---------------------------------------------------------------------------
# Identify yourself; put a real contact so site owners can reach you.
SCRAPER_USER_AGENT=vingo-rag-bot/0.1 (personal portfolio project; contact: you@example.com)
SCRAPER_REQUEST_DELAY_SECONDS=2
SCRAPER_TIMEOUT_SECONDS=20
SCRAPER_MAX_ARTICLES_PER_SOURCE=30
# Set after the Phase 1 chunk-size experiment
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=50

# ---------------------------------------------------------------------------
# RETRIEVAL / AGENT (calibrate these on the golden query set in Phase 2)
# ---------------------------------------------------------------------------
RETRIEVAL_TOP_K=12
CONTEXT_TOP_N=4
# Web answers get a much larger context than index answers.
WEB_CONTEXT_TOP_N=10
MAX_CHUNKS_PER_ARTICLE=1
NEIGHBOUR_CHUNKS=1
MAX_SUB_QUERIES=3
CONTEXT_RELATIVE_FLOOR=0.65
CONFIDENCE_THRESHOLD=0.53
# Top-1 scores within +/- this of the threshold are judged by the small model instead of a bare cutoff.
CONFIDENCE_GRAY_MARGIN=0.08
MAX_EVAL_RETRIES=1

# ---------------------------------------------------------------------------
# ANSWER CACHE (stored in Supabase Postgres, no Redis needed)
# ---------------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_SEMANTIC_THRESHOLD=0.95
CACHE_TTL_HOURS=24

# ---------------------------------------------------------------------------
# APP
# ---------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
# Frontend (Vite)
VITE_API_URL=http://localhost:8000
